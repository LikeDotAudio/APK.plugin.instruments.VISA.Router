{
  "model": "3235",
  "family": "Router",
  "set": {
    "Close_Channels": {
      "scpi": "CLOSE <channel_list>",
      "scpiFast": "CLOS <channel_list>",
      "description": "Close Channels",
      "arg": {
        "kind": "string"
      },
      "group": "Close Relays",
      "args": [
        "channel_list"
      ]
    },
    "Open_Channels": {
      "scpi": "OPEN <channel_list>",
      "description": "Open Channels",
      "arg": {
        "kind": "string"
      },
      "group": "Open Relays",
      "args": [
        "channel_list"
      ]
    }
  },
  "do": {
    "Close_Card_0": {
      "scpi": "CLOSE 000-099",
      "description": "Coax Left: close every relay on slot 0",
      "group": "Close Relays",
      "notes": "Every relay of the card in slot 0 closed — its bank ties and backplane relays too, so every channel on it is tied to every other and to all four buses. Pressed only by a person."
    },
    "Close_All": {
      "scpi": "CLOSE 000-999",
      "description": "Close every relay in the frame — everything connected to everything.",
      "group": "System Reset & Control",
      "subsystem": "Root",
      "notes": "The other half of THE HOUR's chak-chuck (3235.gui `declared.on_the_hour`): every relay pulls in, then Open_All lets every one go, so the frame is heard to work at exactly the top of each hour and is left with nothing connected. Never sent on its own by anything automatic — left closed it ties every input to every output."
    },
    "Close_Card_1": {
      "scpi": "CLOSE 100-199",
      "description": "Coax Right: close every relay on slot 1",
      "group": "Close Relays",
      "notes": "Every relay of the card in slot 1 closed — its bank ties and backplane relays too, so every channel on it is tied to every other and to all four buses. Pressed only by a person."
    },
    "Close_Card_6": {
      "scpi": "CLOSE 600-699",
      "description": "EDAC 1: close every relay on slot 6",
      "group": "Close Relays",
      "notes": "Every relay of the card in slot 6 closed — its bank ties and backplane relays too, so every channel on it is tied to every other and to all four buses. Pressed only by a person."
    },
    "Connect_Card_6_AB0": {
      "scpi": "CLOSE 690",
      "description": "EDAC 1: connect bank 0 outputs to AB0 (LEFT SEND)",
      "group": "Backplane Buses",
      "notes": "Closes slot 6 backplane relay 90 (channel 690), tying the card's bank 0 common to analog bus AB0 — Signal Gen Left · stimulus · LEFT SEND. From gui/Cards.json (bank 0 bus AB0, bus_relay 90). Pressed only by a person."
    },
    "Connect_Card_6_AB1": {
      "scpi": "CLOSE 691",
      "description": "EDAC 1: connect bank 1 inputs to AB1 (LEFT RETURN)",
      "group": "Backplane Buses",
      "notes": "Closes slot 6 backplane relay 91 (channel 691), tying the card's bank 1 common to analog bus AB1 — Test Dest Left · measurement · LEFT RETURN. From gui/Cards.json (bank 1 bus AB1, bus_relay 91). Pressed only by a person."
    },
    "Connect_Card_6_AB2": {
      "scpi": "CLOSE 692",
      "description": "EDAC 1: connect bank 2 outputs to AB2 (RIGHT SEND)",
      "group": "Backplane Buses",
      "notes": "Closes slot 6 backplane relay 92 (channel 692), tying the card's bank 2 common to analog bus AB2 — Signal Gen Right · stimulus · RIGHT SEND. From gui/Cards.json (bank 2 bus AB2, bus_relay 92). Pressed only by a person."
    },
    "Connect_Card_6_AB3": {
      "scpi": "CLOSE 693",
      "description": "EDAC 1: connect bank 3 inputs to AB3 (RIGHT RETURN)",
      "group": "Backplane Buses",
      "notes": "Closes slot 6 backplane relay 93 (channel 693), tying the card's bank 3 common to analog bus AB3 — Test Dest Right · measurement · RIGHT RETURN. From gui/Cards.json (bank 3 bus AB3, bus_relay 93). Pressed only by a person."
    },
    "Close_Card_7": {
      "scpi": "CLOSE 700-799",
      "description": "EDAC 2: close every relay on slot 7",
      "group": "Close Relays",
      "notes": "Every relay of the card in slot 7 closed — its bank ties and backplane relays too, so every channel on it is tied to every other and to all four buses. Pressed only by a person."
    },
    "Connect_Card_7_AB0": {
